{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicr:records:0.1.0",
  "description": "Storage contracts v0.1. Extension fields allowed; blinded model inputs use a separate allowlist.",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample": {
      "type": "object",
      "required": ["id", "provider", "repo_id", "pr_number", "comment_id", "comment_kind", "body", "body_hash", "comment_text", "created_at", "updated_at", "source_url", "path", "side", "original_commit_id", "snapshot_id", "snapshot_status", "body_history_status", "strict_eligible", "eligibility_reasons", "generator_rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "provider": {"enum": ["github", "gitlab"]},
        "repo_id": {"type": "string", "minLength": 1}, "pr_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": ["integer", "string"]}, "comment_kind": {"enum": ["review_comment", "review", "issue_comment", "note"]},
        "body": {"type": "string"}, "body_hash": {"$ref": "#/$defs/hash"}, "comment_text": {"type": "string"},
        "generator_rationale": {"type": ["string", "null"]}, "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}, "source_url": {"type": "string", "format": "uri"},
        "path": {"type": "string"}, "side": {"enum": ["LEFT", "RIGHT"]},
        "original_commit_id": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "snapshot_id": {"type": ["string", "null"]}, "snapshot_status": {"enum": ["exact", "partial", "unavailable"]},
        "body_history_status": {"enum": ["exact_at_t0", "current_only"]}, "strict_eligible": {"type": "boolean"},
        "eligibility_reasons": {"type": "array", "items": {"type": "string"}},
        "user_reaction": false, "teacher": false
      }
    },
    "signal": {
      "type": "object", "required": ["sample_id", "object_kind", "source_object_id", "summary", "observed_at", "reactions_complete", "events"],
      "properties": {
        "sample_id": {"type": "string"}, "object_kind": {"enum": ["review_comment", "review", "issue_comment", "note"]},
        "source_object_id": {"type": ["integer", "string"]}, "summary": {"type": "object"},
        "observed_at": {"type": "string", "format": "date-time"}, "reactions_complete": {"type": "boolean"},
        "events": {"type": "array", "items": {
          "type": "object", "required": ["id", "content", "reactor_key", "reactor_type", "is_self"],
          "properties": {"id": {"type": ["integer", "string"]}, "content": {"type": "string"},
            "reactor_key": {"$ref": "#/$defs/hash"}, "reactor_type": {"type": ["string", "null"]}, "is_self": {"type": "boolean"}}
        }}
      }
    },
    "snapshot": {
      "type": "object", "required": ["id", "repo_id", "commit_sha", "captured_at", "source_url", "archive_sha256", "files", "partial", "skipped"],
      "properties": {
        "id": {"type": "string"}, "repo_id": {"type": "string"}, "commit_sha": {"$ref": "#/$defs/sha"},
        "archive_sha256": {"$ref": "#/$defs/hash"}, "captured_at": {"type": "string", "format": "date-time"},
        "source_url": {"type": "string", "format": "uri"}, "partial": {"type": "boolean"}, "skipped": {"type": "object"},
        "files": {"type": "object", "additionalProperties": {"type": "object", "required": ["text", "raw_sha256", "text_sha256"],
          "properties": {"text": {"type": "string"}, "raw_sha256": {"$ref": "#/$defs/hash"}, "text_sha256": {"$ref": "#/$defs/hash"}}}}
      }
    },
    "manifest": {
      "type": "object", "required": ["id", "config", "code_hash", "deployment", "selected", "sample_hashes", "snapshot_hashes", "modes", "strict_only"],
      "properties": {
        "id": {"type": "string"}, "config": {"type": "object"}, "code_hash": {"$ref": "#/$defs/hash"}, "deployment": {"$ref": "#/$defs/hash"},
        "selected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sample_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
        "snapshot_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
        "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["local", "static", "agent"]}}, "strict_only": {"type": "boolean"}
      }
    },
    "run_attempt": {
      "type": "object", "required": ["id", "run_id", "sample_id", "mode", "started_at", "finished_at", "status", "wall_seconds", "trace_ref", "assessment_ref"],
      "properties": {
        "id": {"type": "string"}, "run_id": {"type": "string"}, "sample_id": {"type": "string"}, "mode": {"enum": ["local", "static", "agent"]},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["ok", "json_invalid", "semantic_invalid", "evidence_invalid", "budget_exhausted", "timeout", "endpoint_error"]},
        "wall_seconds": {"type": "number", "minimum": 0}, "trace_ref": {"type": "string"}, "assessment_ref": {"type": ["string", "null"]}
      }
    }
  }
}
